{
  "name": "fundguard-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo: Next.js web, NestJS API, Expo mobile",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "turbo": "2.10.12"
  }
}
