# Application
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://your-production-domain.com

# Database
DATABASE_URL="postgresql://USERNAME:PASSWORD@PRODUCTION_DATABASE_HOST:5432/DATABASE_NAME"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-production-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-production-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Market Data
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# OpenAI
OPENAI_API_KEY=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Webhooks
WEBHOOK_SECRET=replace-with-a-long-random-production-webhook-secret

# Trading Provider
TRADING_PROVIDER=
TRADING_API_URL=
TRADING_API_KEY=